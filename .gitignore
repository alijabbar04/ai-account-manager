# ---------------------------------------------------------------------------
#  Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
release/*
!release/latest.example.json

# Packaged binaries go to GitHub Releases, never into the repository.
*.exe
*.msi
*.blockmap
*.nupkg
*.asar

# NOTE: app/ is TRACKED - it is this project's source of record (formatted
# runtime JS, not build output). Never add app/ or app/dist* to this file.
# NOTE: build/ is TRACKED - it holds icon.ico and build.ps1.

# ---------------------------------------------------------------------------
#  SECRETS - never commit
# ---------------------------------------------------------------------------
# Code-signing material. electron-builder reads CSC_LINK / CSC_KEY_PASSWORD
# from the environment; CI reads them from encrypted repository secrets.
*.pfx
*.p12
*.pem
*.key
.env
.env.*
secrets.json
credentials.json

# App state. It lives in %APPDATA%\ClaudeAccountManager, outside this repo -
# listed so an accidental copy into the working tree cannot be staged.
api-keys.json            # API key metadata
api-keys-vault.json      # DPAPI-encrypted API key secrets
profiles.json            # account names and profile folder paths
settings.json
usage-snapshots.json
api-usage-snapshots.json
alerts.json
Local State              # Electron safeStorage master key
.credentials.json        # Claude Code OAuth tokens
.claude.json
*.jsonl                  # usage ledgers

# Real update manifests carry live download URLs and digests.
release/latest.json

# ---------------------------------------------------------------------------
#  Session / browser / credential stores
# ---------------------------------------------------------------------------
*profile*/
User Data/
Local Storage/
Session Storage/
IndexedDB/
Cookies
Cookies-journal
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
#  Logs, diagnostics, screenshots
# ---------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Screenshots can capture real account names and usage figures.
*.png
!build/*.png
*.jpg
*.jpeg

# ---------------------------------------------------------------------------
#  Editor / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.bak
*.swp
Thumbs.db
desktop.ini
.DS_Store
