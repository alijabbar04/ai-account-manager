{
  "name": "ai-account-manager-desktop",
  "productName": "AI Account Manager",
  "version": "1.4.1",
  "description": "Manage Claude accounts, GPT/Codex usage, provider permissions, alerts, and API analytics.",
  "private": true,
  "main": "app/dist-electron/main.cjs",
  "exports": {
    ".": "./app/dist-electron/main.cjs",
    "./usage-reader": "./reader/usage-reader.cjs"
  },
  "bin": {
    "ai-account-manager-usage-reader": "reader/usage-reader-cli.cjs"
  },
  "files": [
    "app/dist-electron",
    "app/dist",
    "app/package.json",
    "reader",
    "README.md",
    "LICENSE",
    "docs/USAGE_READER.md"
  ],
  "scripts": {
    "format": "prettier --write app scripts tests .github",
    "verify": "node scripts/verify-runtime.cjs",
    "audit": "npm audit --audit-level=high",
    "test": "node --test tests/*.test.cjs && node scripts/verify-runtime.cjs",
    "test:consumer": "node scripts/verify-usage-reader-consumer.cjs",
    "build:dir": "npm run test && electron-builder --dir --win",
    "build:win": "npm run test && npm run package:win",
    "package:win": "electron-builder --win nsis --publish never",
    "release:manifest": "node scripts/make-manifest.cjs",
    "usage:read": "node reader/usage-reader-cli.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "io.github.ai-account-manager",
    "productName": "AI Account Manager",
    "asar": true,
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "assets/USAGE_TRACKING_GUIDE.pdf",
        "to": "USAGE_TRACKING_GUIDE.pdf"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "AI-Account-Manager-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "AI Account Manager contributors"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Account Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
