{
  "name": "ai-account-manager-desktop",
  "productName": "AI Account Manager",
  "version": "1.7.0",
  "description": "Manage Claude accounts, GPT/Codex usage, provider permissions, alerts, and API analytics.",
  "private": true,
  "main": "app/dist-electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "format": "prettier --write app scripts tests .github",
    "format:check": "prettier --check app scripts tests .github",
    "verify": "node scripts/verify-runtime.cjs",
    "verify:safestorage": "node scripts/verify-safestorage-migration.cjs",
    "test:runtime": "node --test tests/*.test.cjs && node scripts/verify-runtime.cjs",
    "automation:test": "dotnet run --project automation/tests/AIAccountManager.Automation.Tests/AIAccountManager.Automation.Tests.csproj --configuration Release",
    "automation:harness:build": "dotnet build automation/tests/AIAccountManager.Automation.Harness/AIAccountManager.Automation.Harness.csproj --configuration Release",
    "automation:publish": "dotnet publish automation/src/AIAccountManager.Automation/AIAccountManager.Automation.csproj --configuration Release --runtime win-x64 --self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=false -p:IncludeNativeLibrariesForSelfExtract=true --output automation/artifacts/win-x64 && node scripts/stage-automation-helper.cjs",
    "automation:soak": "automation/artifacts/win-x64/AIAccountManager.Automation.exe --performance-soak 60",
    "test": "npm run test:runtime && npm run automation:test && npm run automation:harness:build",
    "build:dir": "npm run automation:publish && npm test && electron-builder --dir --win",
    "build:win": "npm run automation:publish && npm test && electron-builder --win nsis --publish never",
    "release:manifest": "node scripts/make-manifest.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "prettier": "^3.6.2"
  },
  "build": {
    "appId": "io.github.ai-account-manager",
    "productName": "AI Account Manager",
    "asar": true,
    "files": [
      "**/*"
    ],
    "extraResources": [
      {
        "from": "assets/USAGE_TRACKING_GUIDE.pdf",
        "to": "USAGE_TRACKING_GUIDE.pdf"
      },
      {
        "from": "automation/artifacts/win-x64",
        "to": "automation",
        "filter": [
          "**/AIAccountManager.Automation.exe",
          "**/automation-selectors.v1.json"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "AI-Account-Manager-Setup-${version}.${ext}",
    "win": {
      "icon": "build/icon.ico",
      "signExts": [
        ".exe"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signtoolOptions": {
        "publisherName": "AI Account Manager contributors"
      }
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Account Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
