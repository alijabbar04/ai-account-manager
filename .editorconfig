# Prettier decides JavaScript, JSON, YAML and Markdown formatting; this file
# covers the things Prettier does not touch, so an editor does not undo them.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_size = 4

[*.{cs,csproj}]
indent_size = 4

[*.nsh]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
